# Configuration de Lumen — copier ce fichier en `.env` à côté de `compose.yaml`.
#
# Le `.env` réel est ignoré par git ; ce gabarit-ci est versionné. Ne jamais écrire
# de vraie valeur ici, ni la faire transiter par un canal tiers — messagerie, ticket,
# conversation avec un assistant : une clé transmise est une clé à regénérer.


# ─────────────────────────────────────────────────────────────────────
#  OBLIGATOIRE — une seule variable
# ─────────────────────────────────────────────────────────────────────

# Chiffre les sauvegardes automatiques. À générer sur la machine qui héberge :
#
#   openssl rand -base64 48
#
# Accepte une clé Fernet (44 caractères base64 url-safe terminés par « = ») ou
# toute phrase secrète d'au moins 32 caractères, dérivée automatiquement.
#
# ATTENTION : la changer rend illisibles toutes les sauvegardes déjà produites.
# À conserver aussi précieusement que les données elles-mêmes.
PATRIMOINE_BACKUP_KEY=


# ─────────────────────────────────────────────────────────────────────
#  FACULTATIF — réseau et version des images
# ─────────────────────────────────────────────────────────────────────

# Adresse sur laquelle les ports sont publiés. Par défaut 127.0.0.1 : l'application
# n'est joignable que depuis la machine qui l'héberge. 0.0.0.0 l'ouvre à tout le
# réseau local (http://192.168.x.x:8080) — elle reste injoignable depuis internet
# tant que la box ne redirige pas ces ports, ce qui ne dépend que de vous.
#LUMEN_BIND=0.0.0.0

# Version des images tirées. `latest` suit les livraisons ; un sha de commit fige
# une version précise, pour revenir en arrière (étiquettes visibles dans l'onglet
# Packages du dépôt GitHub).
#LUMEN_VERSION=latest


# ─────────────────────────────────────────────────────────────────────
#  FACULTATIF — base Postgres au lieu de SQLite (docs/MANUEL_EXPLOITATION.md § 14)
# ─────────────────────────────────────────────────────────────────────

# Pour un foyer seul, restez sur SQLite (le défaut) : rien à régler ici. Postgres
# prépare une version hébergée ; une installation ne gère encore qu'un foyer.
#
# Les TROIS lignes vont ensemble : le profil démarre le serveur, le mot de passe du
# rôle applicatif fait basculer l'application dessus. À générer sur la machine qui
# héberge, en hexadécimal — un « $ » serait interprété par Compose :
#
#   openssl rand -hex 32
#
# Posés au PREMIER démarrage du profil : les changer ensuite ne change pas les
# mots de passe déjà créés dans la base (procédure au manuel § 14).
# ATTENTION : basculer une installation SQLite existante repart d'une base VIDE —
# reprise des données au manuel § 14.
#COMPOSE_PROFILES=postgres
#LUMEN_POSTGRES_ADMIN_PASSWORD=
#LUMEN_POSTGRES_APP_PASSWORD=


# ─────────────────────────────────────────────────────────────────────
#  FACULTATIF — cours des cryptomonnaies (CoinGecko)
# ─────────────────────────────────────────────────────────────────────

# Sans cette clé, les lignes CRYPTO affichent « Cotation indisponible (CoinGecko) »
# et le reste de l'application fonctionne normalement : aucun repli sur Yahoo
# Finance n'est tenté, c'est délibéré (cf. services/coingecko_service.py).
#
# Clé « Demo » gratuite, sans carte bancaire (10 000 crédits/mois) :
# https://www.coingecko.com/en/api/pricing -> « Start for Free » du plan Demo,
# puis Developer Dashboard -> clé API.
PATRIMOINE_COINGECKO_API_KEY=


# ─────────────────────────────────────────────────────────────────────
#  FACULTATIF — connexion SSO/OIDC (cf. docs/MANUEL_EXPLOITATION.md § 12.1)
# ─────────────────────────────────────────────────────────────────────

# Laissée à "false", le bouton de connexion SSO n'apparaît pas et rien d'autre ne
# change. Passée à "true", les cinq variables qui suivent deviennent obligatoires.
PATRIMOINE_OIDC_ENABLED=false
PATRIMOINE_OIDC_ISSUER=
PATRIMOINE_OIDC_CLIENT_ID=
PATRIMOINE_OIDC_CLIENT_SECRET=
PATRIMOINE_OIDC_REDIRECT_URI=
PATRIMOINE_OIDC_FRONTEND_URL=

# Facultatives même SSO activé : texte du bouton de connexion, puis correspondance
# des claims OIDC (défauts preferred_username / email / name si laissées vides).
PATRIMOINE_OIDC_DISPLAY_NAME=
PATRIMOINE_OIDC_CLAIM_USERNAME=
PATRIMOINE_OIDC_CLAIM_EMAIL=
PATRIMOINE_OIDC_CLAIM_NOM=
